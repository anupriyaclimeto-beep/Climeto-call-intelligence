PORT=4200
NODE_ENV=development
SQLITE_DB_PATH=./data/workspace.db
WORKSPACE_SAMPLE_DATA=false
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Read-only Supabase bridge for pulling completed live calls into this workspace
SUPABASE_BRIDGE_ENABLED=false
SUPABASE_BRIDGE_DATABASE_URL=
SUPABASE_BRIDGE_POLL_MS=1000
SUPABASE_BRIDGE_LIMIT=20
SUPABASE_BRIDGE_BOOTSTRAP_LIMIT=150
AUTO_PITCH_TRAINING_ON_NEW_CALL=true

# Optional true realtime mode. If not provided, backend falls back to 1-second polling.
SUPABASE_PROJECT_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: set later when Zoho navigation/sync is enabled
ZOHO_CRM_BASE_URL=https://crm.zoho.in/crm/tab/Leads
ZOHO_LEADS_URL_TEMPLATE=https://crm.zoho.in/crm/tab/Leads/search?search_word={phone}
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_BASE_URL=https://www.zohoapis.in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_SYNC_ENABLED=true
ZOHO_SYNC_INTERVAL_SEC=300
ZOHO_MAIL_BASE_URL=https://mail.zoho.in
ZOHO_MAIL_CLIENT_ID=
ZOHO_MAIL_CLIENT_SECRET=
ZOHO_MAIL_REFRESH_TOKEN=
# Comma-separated list of executive emails to track & display on the Email page
ZOHO_TRACKED_EMAILS=ambuj@climeto.com,ram@climeto.com,shriram@climeto.com,jay@climeto.com,hemal@climeto.com
ZOHO_HIDE_AUTOMATED_EMAILS=true

# Manyreach webhook + campaigns feed
# Generate a long random string and paste the same value in Manyreach CustomWebhook URL ?token=
MANYREACH_WEBHOOK_SECRET=
# Optional API key for future fallback sync (default OFF)
MANYREACH_API_KEY=
MANYREACH_API_BASE_URL=https://api.manyreach.com
MANYREACH_SYNC_ENABLED=false
# When false, seeded campaign_events rows are hidden from /api/campaigns/feed
SHOW_SEEDED_CAMPAIGNS=false

# WhatsApp Multi-Device Server Bridge (Company Work SIM mode)
# When true, captures all 1-on-1 chats on company work SIMs (not just existing CRM leads)
WHATSAPP_CAPTURE_ALL=true
# When true, automatically creates a new Lead in CRM when a brand-new client messages on WhatsApp first
WHATSAPP_AUTO_CREATE_LEAD=true

# Gemini AI for Pitch Training, Call/WhatsApp Scoring, Suggested Replies & Roleplay
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# MCA Licensed Corporate Data Provider (Surepass / Attestr / Probe42 / Tofler)
# Required for official MCA Master Data, Filed Audited Financials, and CIN lookups
MCA_PROVIDER_API_KEY=
MCA_PROVIDER_BASE_URL=https://kyc-api.surepass.io/api/v1
